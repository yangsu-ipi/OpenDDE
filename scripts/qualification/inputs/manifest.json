{
 "description": "Frozen qualification inputs (porting_docs/qualification_protocol.md). Run from the repository root: input JSONs use repository-relative MSA and template paths.",
 "common_flags": [
  "--sample",
  "5",
  "--step",
  "200",
  "--cycle",
  "10",
  "--dtype",
  "bf16",
  "--use_template",
  "false",
  "--use_rna_msa",
  "false",
  "--enable_tf32",
  "false"
 ],
 "common_flags_note": "Row flags come after the common flags and override them. LAYERNORM_TYPE=torch unless a test says otherwise. Paired runs set sorted_by_ranking_score=false through run_opendde.py --set; row overrides use the same option.",
 "development_seeds": [
  101,
  102
 ],
 "held_out_seed_range": [
  201,
  299
 ],
 "held_out_seed_rule": "single-use; drawn per held-out qualification and recorded in the held-out log",
 "rows": [
  {
   "id": "D1",
   "role": "development",
   "input": "examples/cofold/protein_200.json",
   "job": "synthetic_protein_200",
   "covers": "protein only, small, no MSA",
   "flags": [
    "--use_msa",
    "false"
   ]
  },
  {
   "id": "D2",
   "role": "development",
   "input": "scripts/qualification/inputs/d2_7r6r.json",
   "job": "7r6r",
   "covers": "protein-DNA, MSA, small",
   "flags": [
    "--use_msa",
    "true"
   ],
   "reference": "${OPENDDE_QUAL_DATA}/references/7r6r.cif",
   "external_data": [
    "${OPENDDE_QUAL_DATA}/references/7r6r.cif"
   ]
  },
  {
   "id": "D3",
   "role": "development",
   "input": "examples/tfg/1a14/1a14_unconstrained.json",
   "job": "1a14_unconstrained",
   "covers": "three protein chains, paired MSA, medium",
   "flags": [
    "--use_msa",
    "true"
   ],
   "reference": "${OPENDDE_QUAL_DATA}/references/1a14.cif",
   "external_data": [
    "${OPENDDE_QUAL_DATA}/references/1a14.cif"
   ]
  },
  {
   "id": "D4",
   "role": "development",
   "input": "scripts/qualification/inputs/d4_7wux.json",
   "job": "7wux",
   "covers": "heterotetramer with ligands and ions, MSA, large",
   "flags": [
    "--use_msa",
    "true"
   ],
   "reference": "${OPENDDE_QUAL_DATA}/references/7wux.cif",
   "external_data": [
    "${OPENDDE_QUAL_DATA}/references/7wux.cif"
   ]
  },
  {
   "id": "D5",
   "role": "development",
   "input": "examples/cofold/template/example_9fm7.json",
   "job": "9fm7",
   "covers": "template and MSA, protein dimer with ligands",
   "flags": [
    "--use_msa",
    "true",
    "--use_template",
    "true",
    "--kalign_binary_path",
    "${OPENDDE_QUAL_KALIGN}"
   ],
   "overrides": [
    "data.template.prot_template_mmcif_dir=${OPENDDE_QUAL_DATA}/template_mmcif",
    "data.template.fetch_remote=false",
    "data.template.prot_template_cache_dir={out}/template_cache"
   ],
   "external_data": [
    "${OPENDDE_QUAL_DATA}/template_mmcif",
    "${OPENDDE_QUAL_DATA}/references/9fm7.cif"
   ],
   "note": "Templates: kalign 2.04 and the four mmCIF files fetched once from PDBe (5ocm, 3zgy, 5a9s, 5a9r), checked by freeze_inputs.py check --external; no network access during runs.",
   "reference": "${OPENDDE_QUAL_DATA}/references/9fm7.cif"
  },
  {
   "id": "D6",
   "role": "development",
   "input": "examples/cofold/rna_msa/example_9gmw_2.json",
